# ─────────────────────────────────────────────
# FanPulse — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Free options: Supabase (supabase.com), Neon (neon.tech), Railway (railway.app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fanpulse"

# ── App ───────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="info"

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
# The Prisma cuid of your Club record — printed by npm run db:seed on first run.
# Every Prisma query is scoped to this club, keeping each club's data isolated.
CLUB_ID=""

# ── Pipeline Security ─────────────────────────────────────────────────────────
# A strong random string used to protect the /api/sync and /api/enrich endpoints.
# Generate one: openssl rand -hex 32
PIPELINE_SECRET="REPLACE_WITH_STRONG_SECRET"

# Vercel injects this automatically into every cron job request as a bearer token.
# Copy the value from: Vercel dashboard → Project → Settings → Environment Variables
# It must match the CRON_SECRET Vercel uses, so set it to the same value there.
CRON_SECRET=""

# ── Ticketing Adapter ─────────────────────────────────────────────────────────
# Mode: "api" (live API integration) or "csv" (manual file upload)
TICKETING_MODE="csv"
TICKETING_CSV_PATH="/tmp/tickets-export.csv"

# For API mode:
# TICKETING_API_URL="https://api.yourticketing.com"
# TICKETING_API_KEY="your-api-key"
# TICKETING_LAST_SYNC=""  # ISO date — only fetch records updated since this date

# ── Membership Adapter ────────────────────────────────────────────────────────
MEMBERSHIP_MODE="csv"
MEMBERSHIP_CSV_PATH="/tmp/memberships-export.csv"

# For API mode:
# MEMBERSHIP_API_URL="https://api.yourmembership.com"
# MEMBERSHIP_API_KEY="your-api-key"

# ── E-commerce Adapter ────────────────────────────────────────────────────────
# Mode: "shopify", "woocommerce", or "csv"
ECOMMERCE_MODE="csv"
ECOMMERCE_CSV_PATH="/tmp/orders-export.csv"

# For Shopify:
# ECOMMERCE_MODE="shopify"
# ECOMMERCE_API_URL="https://yourstore.myshopify.com/admin/api/2024-01"
# ECOMMERCE_API_KEY="shpat_xxxxx"

# ── Social Adapter ────────────────────────────────────────────────────────────
# Meta (Facebook/Instagram) — requires approved app with pages_read_engagement permission
# SOCIAL_META_PAGE_ID="your-page-id"
# SOCIAL_META_ACCESS_TOKEN="your-access-token"

# X (Twitter) — requires Elevated API v2 access
# SOCIAL_X_BEARER_TOKEN="your-bearer-token"

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron expressions (server timezone). Defaults: 2am and 3am every night.
PIPELINE_CRON="0 2 * * *"
ENRICHMENT_CRON="0 3 * * *"

# ── Email (for future campaign automation) ────────────────────────────────────
# SENDGRID_API_KEY="SG.xxxxx"
# EMAIL_FROM="noreply@falkirkfc.co.uk"
# EMAIL_FROM_NAME="Falkirk FC"
